#!/usr/bin/env python3
"""Build the QQ proxy gate against the pinned deployed BungeeCord API."""
from pathlib import Path
import subprocess
import shutil
import os
root = Path(__file__).resolve().parents[1]
build = root / 'downloads/identity-build'
build.mkdir(parents=True, exist_ok=True)
home = os.environ.get('JAVA_HOME')
if not home:
    home = subprocess.check_output(['/usr/libexec/java_home'], text=True).strip()
subprocess.run([str(Path(home) / 'bin/javac'), '--release', '17', '-encoding', 'UTF-8',
                '-cp', str(root / 'downloads/BungeeCord-2096.jar'), '-d', str(build),
                str(root / 'plugins/identity/src/XduIdentity.java')], check=True)
shutil.copyfile(root / 'plugins/identity/plugin.yml', build / 'bungee.yml')
jar = root / 'downloads/XduIdentity.jar'
subprocess.run([str(Path(home) / 'bin/jar'), '--create', '--file', str(jar), '-C', str(build), '.'], check=True)
print(jar)
