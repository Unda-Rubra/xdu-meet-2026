#!/usr/bin/env python3
"""Grant or revoke lobby settings access for one verified connected session."""
import argparse
from pathlib import Path
import sys
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from raceops.identity import NAME
from raceops.transport import Backend
from raceops.cli import audit, exclusive

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("action", choices=("grant", "revoke"))
parser.add_argument("name", help="Exact connected Minecraft name, verified by the host")
args = parser.parse_args()
try:
    if not NAME.fullmatch(args.name):
        raise ValueError("Invalid Minecraft name")
    with exclusive():
        backend = Backend("lobby")
        if backend.read("ready", "xdu_lobby:state") != 1:
            raise ValueError("Native waiting room is not ready")
        response = backend.command(f"data get entity @a[name={args.name},limit=1] UUID")
        if "entity data" not in response:
            raise ValueError("Player is not connected to the lobby")
        verb = "add" if args.action == "grant" else "remove"
        print(backend.command(f"tag @a[name={args.name},limit=1] {verb} xdu_lobby_operator"))
        if args.action == "revoke":
            backend.command(f"tag @a[name={args.name},limit=1] remove admin")
        audit({"command": "lobby-operator", "action": args.action, "player": args.name, "phase": "confirmed"})
except (OSError, ValueError, RuntimeError) as error:
    parser.exit(1, f"lobby-operator: {error}\n")
