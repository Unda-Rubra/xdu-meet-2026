{
  "schema_version": 2,
  "adapter_version": "2.0.0",
  "identity_mode": "offline_trusted_private",
  "administration": "console_granted_commentator_tags",
  "namespace": "xdu_race",
  "state_storage": "xdu_race:state",
  "request_storage": "xdu_race:request",
  "result_storage": "xdu_race:results",
  "current_path": "current",
  "history_path": "attempts",
  "states": [
    "IDLE",
    "PREPARED",
    "RUNNING",
    "WAITING",
    "CEREMONY",
    "GP_FINISHED",
    "ERROR"
  ],
  "group_options": [
    [
      "A",
      "B"
    ],
    [
      "A",
      "B",
      "C"
    ]
  ],
  "max_group_players": 17,
  "native_gp_settings": "captured_from_main_lobby",
  "record_key": [
    "attempt_id",
    "group",
    "qq"
  ],
  "commands": [
    "start",
    "status",
    "admin"
  ],
  "export_mutates_world": false,
  "cloud_upload": "explicit_token_only"
}
