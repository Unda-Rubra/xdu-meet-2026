# Private trusted event only. Do not bind publicly without an event-network firewall.
EVENT_BIND=127.0.0.1
# No Docker memory/CPU ceilings. Tune these JVM heaps on the event host.
# Defaults suit local functional checks, not a 50-player capacity promise.
RACE_HEAP=1024M
LOBBY_HEAP=512M
PROXY_HEAP=256M
# scripts/up supplies the invoking operator's UID/GID automatically.
